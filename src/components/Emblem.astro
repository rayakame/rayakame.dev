---
// The site mark, artwork in src/lib/emblem.ts. Colour comes from --accent via
// .emblem. Sizes in use: 24px (spine), 72px (lockup), 22px / 56px on mobile.
import { EMBLEM_PATHS, EMBLEM_VIEWBOX } from '../lib/emblem';

interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  class:list={['emblem', className]}
  width={size}
  height={size}
  viewBox={EMBLEM_VIEWBOX}
  fill="currentColor"
  aria-hidden="true"
>
  {EMBLEM_PATHS.map((d) => (
    <path d={d}></path>
  ))}
</svg>
