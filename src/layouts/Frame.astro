---
// Page frame shared by both pages: spine, top bar, bottom bar, scanline
// overlay and registration marks. The page's panels go in the default slot,
// the top-bar status text in the `status` slot.
import Emblem from '../components/Emblem.astro';
import { site } from '../config/site';
import '../styles/site.css';

interface Props {
  title: string;
  page: 'index' | 'projects' | 'about';
  /** Also place registration marks on the panel divider (index page). */
  divider?: boolean;
}

const { title, page, divider = false } = Astro.props;
const marks = ['spine-top', 'spine-bottom', ...(divider ? ['divider-top', 'divider-bottom'] : [])];
const fonts = [...['300', '400', '500'].map((weight) => `/fonts/martian-mono-latin-${weight}-normal.woff2`), '/fonts/martian-mono-arrow-400-normal.woff2'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <div class="frame">
      <aside class="spine">
        <a class="spine__home" href="/" aria-label="Home">
          <Emblem size={32} class="spine__emblem" />
        </a>
        <div class="spine__name">{site.name}</div>
        <div class="spine__year">{site.year}</div>
      </aside>

      <div class="column">
        <header class="topbar">
          <nav class="nav">
            <a class="nav__link" href="/" aria-current={page === 'index' ? 'page' : undefined}>Index</a>
            <a class="nav__link" href="/about/" aria-current={page === 'about' ? 'page' : undefined}>About</a>
            <a class="nav__link" href="/projects/" aria-current={page === 'projects' ? 'page' : undefined}>Projects</a>
          </nav>
          <div class="status">
            <span class="status__dot"></span>
            <span class="status__text"><slot name="status" /></span>
          </div>
        </header>

        <div class="panels">
          <slot />
        </div>

        <footer class="bottombar">
          <div class="bottombar__links">
            {site.contacts.map((c) => <a class="bottombar__link" href={c.href}>{c.label}</a>)}
          </div>
          <span>© {site.year}</span>
        </footer>
      </div>

      <div class="scan"></div>

      {
        marks.map((mark) => (
          <svg class={`mark mark--${mark}`} width="13" height="13" viewBox="0 0 13 13" aria-hidden="true">
            <path d="M6.5 0V13M0 6.5H13" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1" />
          </svg>
        ))
      }
    </div>
  </body>
</html>
