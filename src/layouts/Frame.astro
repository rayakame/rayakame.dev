---
// Page frame shared by both pages: spine, top bar, bottom bar, scanline
// overlay and registration marks. The page's panels go in the default slot,
// the top-bar status text in the `status` slot.
import Emblem from '../components/Emblem.astro';
import { site } from '../config/site';
import '../styles/site.css';

interface Props {
  title: string;
  /** One sentence for search engines and link previews. */
  description: string;
  page: 'index' | 'projects' | 'about' | 'none';
  /** Also place registration marks on the panel divider (index page). */
  divider?: boolean;
}

const { title, description, page, divider = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// `astro dev` serves styles and the HMR client inline, which a bare 'self'
// policy drops on the floor -- the dev page renders unstyled. The build emits
// every script and stylesheet as its own file (see astro.config.mjs), so the
// policy that actually ships stays strict.
const dev = import.meta.env.DEV;
const csp = [
  "default-src 'self'",
  `script-src 'self'${dev ? " 'unsafe-inline'" : ''}`,
  `style-src 'self'${dev ? " 'unsafe-inline'" : ''}`,
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self'${dev ? ' ws:' : ''} https://api.github.com https://api.open-meteo.com`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  // Would rewrite http://<lan-ip>:4321 asset URLs to https during dev.
  ...(dev ? [] : ['upgrade-insecure-requests']),
].join('; ');
const footerContacts = site.contacts.filter((c) => c.footer);
const marks = ['spine-top', 'spine-bottom', ...(divider ? ['divider-top', 'divider-bottom'] : [])];
const fonts = [
  ...['300', '400', '500'].map((weight) => `/fonts/martian-mono-latin-${weight}-normal.woff2`),
  '/fonts/martian-mono-arrow-400-normal.woff2',
];
---

<!doctype html>
<html lang="en" data-theme={site.theme === 'default' ? undefined : site.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {fonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <div class="frame">
      <aside class="spine">
        <a class="spine__home" href="/" aria-label="Home">
          <Emblem size={32} class="spine__emblem" />
        </a>
        <div class="spine__name">{site.name}</div>
        <div class="spine__year">{site.year}</div>
      </aside>

      <div class="column">
        <header class="topbar">
          <nav class="nav">
            <a class="nav__link" href="/" aria-current={page === 'index' ? 'page' : undefined}>
              Index
            </a>
            <a class="nav__link" href="/about/" aria-current={page === 'about' ? 'page' : undefined}>
              About
            </a>
            <a class="nav__link" href="/projects/" aria-current={page === 'projects' ? 'page' : undefined}>
              Projects
            </a>
          </nav>
          <div class="status">
            <span class="status__dot"></span>
            <span class="status__text">
              <slot name="status" />
            </span>
          </div>
        </header>

        <div class="panels">
          <slot />
        </div>

        <footer class="bottombar">
          <div class="bottombar__links">
            {footerContacts.map((c) => (
              <a class="bottombar__link" href={c.href}>
                {c.label}
              </a>
            ))}
          </div>
          <div class="bottombar__right">
            <span>© {site.year}</span>
          </div>
        </footer>
      </div>

      <div class="scan"></div>

      {marks.map((mark) => (
        <svg class={`mark mark--${mark}`} width="13" height="13" viewBox="0 0 13 13" aria-hidden="true">
          <path d="M6.5 0V13M0 6.5H13" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1" />
        </svg>
      ))}
    </div>
  </body>
</html>
