---
import Frame from '../layouts/Frame.astro';
import Honeycomb from '../components/Honeycomb.astro';
import Row from '../components/Row.astro';
import { projectsConfig } from '../config/projects';
import { site } from '../config/site';
import { fallbackProjects, fetchGitHubData, resolveProjects, toRows } from '../lib/projects';

// Rows are rendered at build time (a GITHUB_TOKEN raises the API limit in CI)
// and refreshed in the browser by src/scripts/projects.ts. In CI a failed fetch
// fails the build so the previous good deployment stays up; locally it falls
// back to the MANUAL + PINNED rows.
const ci = Boolean(import.meta.env.CI);
let projects;
try {
  const token: string | undefined = import.meta.env.GITHUB_TOKEN;
  const data = await fetchGitHubData(projectsConfig, { token, strict: ci });
  projects = resolveProjects(projectsConfig, data);
  console.log(`[projects] ${projects.length} projects, ${Object.keys(data).length} with data from GitHub${token ? ' (authenticated)' : ''}`);
} catch (err) {
  if (ci) throw err;
  console.warn('[projects] GitHub fetch failed at build time, rendering MANUAL + PINNED only:', err);
  projects = fallbackProjects(projectsConfig);
}
const rows = toRows(projects);
const count = String(rows.length).padStart(2, '0');
---

<Frame title={`Projects · ${site.name}`} page="projects">
  <span slot="status"><span data-repo-count>{count}</span> repositories · GitHub</span>

  <section class="list-panel">
    <Honeycomb class="honeycomb--list" cluster="top-right" mirror strokeOpacity={0.18} fillOpacity={0.1} width={264} height={230} viewBox="280 566 264 230" />

    <div class="list-head">
      <button class="list-head__no list-head__sort" type="button" data-sort="no" aria-pressed="true" data-dir="asc">No</button>
      <button class="list-head__name list-head__sort" type="button" data-sort="name">Name</button>
      <span class="list-head__desc">Description</span>
      <button class="list-head__lang list-head__sort" type="button" data-sort="lang">Lang</button>
      <button class="list-head__stars list-head__sort" type="button" data-sort="stars">Stars</button>
      <button class="list-head__pushed list-head__sort" type="button" data-sort="pushed">Pushed</button>
      <span class="list-head__arrow"></span>
    </div>

    <div class="list" data-projects>
      {rows.map((row) => <Row {...row} />)}
    </div>

    <template id="row-template"><Row /></template>
    <script type="application/json" id="projects-json" is:inline set:html={JSON.stringify(rows).replace(/</g, '\\u003c')} />
    <script src="../scripts/projects.ts"></script>
  </section>
</Frame>
